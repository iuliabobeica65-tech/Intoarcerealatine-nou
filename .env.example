# Documentation only. Configure secrets in Cloudflare dashboard, never commit real values.
APP_ORIGIN=https://preview.example.invalid
# TEST_MODE=true is mandatory for an authorized isolated test; no service is enabled here.
TEST_MODE=true
# Future public collection profile: use docs/brevo-pregatire/newsletter-collection.json.
# These approval gates must remain false until the concrete public setup is approved.
NEWSLETTER_COLLECTION_ONLY=false
NEWSLETTER_AUTOMATIONS_REVIEWED=false
NEWSLETTER_PRIVACY_APPROVED=false
TEST_BREVO_LIST_ID=7
# Private server value, never place it in public config or Git: TEST_RECIPIENT_EMAIL.
COMMUNITY_ENABLED=false
REGISTRATIONS_ENABLED=false
EMAIL_SEND_ENABLED=false
PAYMENTS_TEST_ENABLED=false
LIVE_PAYMENTS_ENABLED=false
BREVO_DOI_TEMPLATE_ID=12
# Isolated test only; the application origin stays private and the redirect is public.
TEST_DOI_REDIRECTION_URL=https://iuliabobeica.ro/live
TURNSTILE_SITE_KEY=
WHATSAPP_COMMUNITY_URL=
# Existing Google booking page only; keep OFF until URL and settings are approved.
GOOGLE_APPOINTMENTS_ENABLED=false
GOOGLE_APPOINTMENT_URL=
APPROVED_TEMPLATE_IDS=[]
BILLING_PROVIDER=mock
INVOICING_ENABLED=false
INVOICE_EMAIL_SENDER=none
# Secrets: BREVO_API_KEY, TURNSTILE_SECRET, DATA_HMAC_KEY, ADMIN_TOKEN,
# STRIPE_SECRET_KEY (sk_test_ only), STRIPE_WEBHOOK_SECRET (whsec_).
# D1 binding: DB. Apply all migrations in this exact order, isolated test DB only:
# 0001.sql, 0002-smartbill.sql, 0003-lifecycle.sql, 0004-invoice-refund.sql,
# 0005-event-admin.sql, 0006-load-indexes.sql.
# See infrastructure/migrations and docs/CONFIGURARE-SERVICII.md; never use production DB.
